header {
  background-color: #fff;
  justify-content: space-between;
  align-items: center;
  height: 60px;
  padding: 0 50px;
  font-family: Roboto, sans-serif;
  display: flex;
  position: relative;
}

.nav__item:not(:last-child) {
  margin-right: 20px;
}

.nav__list {
  text-transform: uppercase;
  margin: 0;
  padding: 0;
  font-size: 12px;
  list-style: none;
  display: flex;
}

.nav__list :hover {
  color: #00acdc;
  transition: color .3s;
}

.nav__link {
  color: #060b35;
  align-items: center;
  padding: 23px 0;
  font-weight: 500;
  line-height: 14px;
  text-decoration: none;
  list-style: none;
  display: flex;
}

.logo {
  width: 40px;
  height: 40px;
  display: block;
}

.is-active {
  color: #00acdc;
  position: relative;
}

.is-active:after {
  content: "";
  background-color: #00acdc;
  border-radius: 8px;
  width: 100%;
  height: 4px;
  display: block;
  position: absolute;
  bottom: 0;
}

.item {
  background: #fff;
  border: 1px solid #f3f3f3;
  border-radius: 5px;
  width: 200px;
  height: 100%;
  padding: 32px 16px 16px;
  transition: transform .3s, z-index .3s;
  position: relative;
}

.item__image {
  object-fit: cover;
  width: 160px;
  height: 134px;
  margin: 0 3px;
  display: block;
}

.item__name {
  color: #060b35;
  margin: 40px 0 0;
  font-family: Roboto, sans-serif;
  font-size: 12px;
  font-weight: 500;
  line-height: 150%;
}

.item__code {
  color: #616070;
  margin: 4px 0;
  font-family: Roboto, sans-serif;
  font-size: 10px;
  font-weight: 400;
  line-height: 140%;
}

.item__price-name {
  color: #616070;
  justify-content: space-between;
  margin: 24px 0 0;
  font-family: Roboto, sans-serif;
  font-size: 12px;
  font-weight: 400;
  line-height: 150%;
  display: flex;
}

.item__price-number {
  color: #060b35;
  text-align: right;
  font-family: Roboto, sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 112%;
}

.item__button {
  text-transform: uppercase;
  color: #fff;
  background-color: #00acdc;
  border-radius: 5px;
  justify-content: center;
  margin: 16px 0 0;
  padding: 12px;
  font-family: Roboto, sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 16px;
  text-decoration: none;
  display: flex;
}

.item__button:hover {
  color: #00acdc;
  background-color: #fff;
  border: 1px solid #00acdc;
  border-radius: 5px;
}

.item:hover {
  z-index: 10;
  transform: scale(1.2);
}

.item:hover .item__name {
  color: #34568b;
}

.stars {
  justify-content: space-between;
  width: 100%;
  height: 16px;
  margin: 16px 0;
  display: flex;
}

.stars__rating {
  align-items: center;
  display: flex;
}

.stars__star {
  background-image: url("star.fa806e3c.svg");
  background-position: center;
  background-repeat: no-repeat;
  width: 16px;
  height: 16px;
  margin-right: 4px;
  transform: scale(1);
}

.stars__code-text {
  color: #060b35;
  margin-top: auto;
  font-family: Roboto, sans-serif;
  font-size: 10px;
  font-weight: 400;
  line-height: 140%;
}

.stars--0 .stars__star:nth-child(-n), .stars--1 .stars__star:nth-child(-n+1), .stars--2 .stars__star:nth-child(-n+2), .stars--3 .stars__star:nth-child(-n+3), .stars--4 .stars__star:nth-child(-n+4), .stars--5 .stars__star:nth-child(-n+5) {
  background-image: url("star-active.2be54011.svg");
}

body {
  margin: 0;
}

.main {
  grid-template-columns: repeat(4, 200px);
  justify-content: center;
  gap: 46px 48px;
  padding: 50px 40px;
  display: grid;
}

@media (width <= 487px) {
  .main {
    grid-template-columns: repeat(1, 200px);
  }
}

@media (width >= 488px) {
  .main {
    grid-template-columns: repeat(2, 200px);
  }
}

@media (width >= 768px) {
  .main {
    grid-template-columns: repeat(3, 200px);
  }
}

@media (width >= 1024px) {
  .main {
    grid-template-columns: repeat(4, 200px);
  }
}
/*# sourceMappingURL=index.e378193d.css.map */
